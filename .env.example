# ------------------------------------------------------------------
# MockMate AI — environment template
# Copy this file to .env and fill in real values. NEVER commit .env.
# ------------------------------------------------------------------
#
# Database connection (MySQL). Create the database first, e.g.:
#   CREATE DATABASE interview_saathi CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
# Example:
# DATABASE_URL=mysql://root:@localhost:3306/interview_saathi
#
# Session signing secret. REQUIRED — the server refuses to start without it.
# Must be at least 32 characters long. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Example:
# JWT_SECRET=replace-this-with-48-random-bytes-base64
#
# Optional: HTTP port (default 3100)
# PORT=3100
#
# Optional: runtime mode. Leave unset (or "development") for pnpm dev.
# Set NODE_ENV=production when running the built app with pnpm start —
# it switches Express to serve the prebuilt client from dist/ and turns
# on secure cookies (requires HTTPS).
# NODE_ENV=development

# Optional: bootstrap admin email. When set, the user who registers with this
# email (case-insensitive) gets role='admin' and the assignment is recorded
# in audit_logs. When unset, no admin exists and /api/v1/admin is
# unreachable. Set it BEFORE the first registration, e.g.:
# ADMIN_EMAIL=admin@example.com

# ------------------------------------------------------------------
# AI provider (Google Gemini) — all optional. The app runs in
# template/demo mode without them; nothing crashes. See AI_SETUP.md.
# ------------------------------------------------------------------
# Get a free key: https://aistudio.google.com → "Get API key"
# (no credit card). NEVER commit a real key.
# GEMINI_API_KEY=
#
# Model id (default: gemini-3.8-flash — best free-tier limits).
# GEMINI_MODEL=gemini-3.8-flash
#
# Which engine interviews use: "template" (default, built-in engine) or
# "gemini" (explicit opt-in). Gemini additionally requires GEMINI_API_KEY
# and AI_MODE != "force-template".
# AI_PROVIDER=template
#
# "auto" (default) lets a configured Gemini run; "force-template" pins the
# built-in engine even when a key is set (handy for demos/tests).
# AI_MODE=auto
